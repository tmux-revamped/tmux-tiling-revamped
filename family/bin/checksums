#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
. "${SCRIPT_DIR}/../lib/common.sh"

ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"
CHECKSUM_FILE="${ROOT}/family/CHECKSUMS"

usage() {
  cat <<'USAGE'
usage: family/bin/checksums [--stdout]

Regenerates family/CHECKSUMS from the owned entries in family/OWNERSHIP.

  --stdout   print the manifest instead of writing it
USAGE
}

generate() {
  local path
  local missing=0

  while IFS= read -r path; do
    case "${path}" in
      MISSING:*)
        printf 'error: ownership names a path that does not exist: %s\n' "${path#MISSING:}" >&2
        missing=1
        continue
        ;;
    esac
    [[ "${path}" == "family/CHECKSUMS" ]] && continue
    printf '%s  %s\n' "$(family_hash_file "${ROOT}/${path}")" "${path}"
  done < <(family_owned_paths "${ROOT}")

  return "${missing}"
}

main() {
  local to_stdout=0

  while [[ $# -gt 0 ]]; do
    case "${1}" in
      --stdout)
        to_stdout=1
        shift
        ;;
      -h | --help)
        usage
        return 0
        ;;
      *)
        usage >&2
        return 2
        ;;
    esac
  done

  local manifest
  manifest="$(generate)"

  if [[ "${to_stdout}" -eq 1 ]]; then
    printf '%s\n' "${manifest}"
    return 0
  fi

  printf '%s\n' "${manifest}" > "${CHECKSUM_FILE}"
  printf 'wrote %s entries to family/CHECKSUMS\n' "$(printf '%s\n' "${manifest}" | wc -l | tr -d ' ')"
}

main "$@"
